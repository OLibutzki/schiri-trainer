{
  "name": "schiri-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Übungs- und Prüfungstrainer für den DHB-Regelfragenkatalog",
  "license": "UNLICENSED",
  "scripts": {
    "validiere": "node skripte/validiere-katalog.mjs",
